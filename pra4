#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>

#define N 5

sem_t chopstick[N];
sem_t room;

void *philosopher(void *arg)
{
    int id = *(int *)arg;

    for (int i = 0; i < 3; i++)
    {
        printf("Philosopher %d is thinking\n", id);
        sleep(1);

        sem_wait(&room);                     // enter the table
        sem_wait(&chopstick[id]);            // pick left chopstick
        sem_wait(&chopstick[(id + 1) % N]);  // pick right chopstick

        printf("Philosopher %d is eating\n", id);
        sleep(2);

        sem_post(&chopstick[(id + 1) % N]);  // put right chopstick
        sem_post(&chopstick[id]);            // put left chopstick
        sem_post(&room);                     // leave the table

        printf("Philosopher %d finished eating\n", id);
    }
    return NULL;
}

int main()
{
    pthread_t thread[N];
    int ids[N];

    sem_init(&room, 0, N - 1);
    for (int i = 0; i < N; i++)
        sem_init(&chopstick[i], 0, 1);

    for (int i = 0; i < N; i++)
    {
        ids[i] = i;
        pthread_create(&thread[i], NULL, philosopher, &ids[i]);
    }

    for (int i = 0; i < N; i++)
        pthread_join(thread[i], NULL);

    for (int i = 0; i < N; i++)
        sem_destroy(&chopstick[i]);
    sem_destroy(&room);

    return 0;
}
